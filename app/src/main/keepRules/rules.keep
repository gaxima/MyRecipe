# Project specific R8 rules. AGP combines all keep rule files in src/main/keepRules.
# See https://d.android.com/r/tools/r8/keep-rules

# kotlinx.serialization: keep generated serializers for DTOs and navigation keys.
-keepclassmembers @kotlinx.serialization.Serializable class com.gaxima.myrecipe.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
}
-keepclasseswithmembers class com.gaxima.myrecipe.**$$serializer { *; }
